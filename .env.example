# ============================================================
#  Acell & Haikal Sanctuary — contoh konfigurasi
#  Salin jadi `.env` lalu isi. File .env TIDAK boleh masuk git.
# ============================================================

# Server Configuration
PORT=23625
NODE_ENV=production

# ── Secrets ─────────────────────────────────────────────────
# Boleh dikosongkan. Kalau kosong, backend membuat sendiri secret acak
# 32-byte pada boot pertama dan menyimpannya di backend/data/.secrets.json
# (di luar git). Nilai lama 'Senin23062025' sudah bocor di git history
# publik dan sekarang ditolak otomatis oleh server.
# JWT_SECRET=
# WEBHOOK_SECRET=

# Couple Profiles
BOY_NAME=Haikal
BOY_NICKNAME=Prince 👑
GIRL_NAME=Acell
GIRL_NICKNAME=Princess 👑
ANNIVERSARY_DATE=2025-06-23

# Dynamic Domain Routing
ACTIVE_DOMAIN=acellimut.my.id
STAGING_DOMAIN=acellimut.my.id
PRIMARY_DOMAIN=acellimut.my.id

# ── Tracking kurir asli ─────────────────────────────────────
# Tanpa key ini, paket tetap tampil tapi ditandai "belum ada checkpoint
# asli" — aplikasi tidak mengarang perjalanan paket.
# Daftar gratis: https://binderbyte.com
COURIER_API_KEY=
COURIER_PROVIDER=binderbyte

# Outbound SMTP (Resend / Brevo / Gmail)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_resend_api_key_here
SMTP_SECURE=false
SMTP_FROM_NAME="Haikal & Acell"

# AI Email & Receipt Intelligence (OhhMyAgent.com / OpenAI)
# Docs: https://ohhmyagent.com/docs
AI_API_KEY=sk-mvx-your_ohhmyagent_key_here
AI_BASE_URL=https://ohhmyagent.com/v1
AI_MODEL=ohh/gpt-5.6
